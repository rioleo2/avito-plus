# TARGET configuration contract; current code does NOT yet read these variables.
# Implement AP-002/AP-007 before using this as runtime configuration.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
SCRAPER_MODE=disabled
DEMO_MODE=false
MAX_CONCURRENT_SEARCHES=1
CACHE_TTL_SECONDS=300
AI_MODE=heuristic
# Local inference optional; on a VM localhost means that VM, not your computer.
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=local-model
AI_API_KEY=
AI_TIMEOUT_SECONDS=15
